# ── Servidor ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Seguridad (CAMBIAR antes de subir a producción) ───────────────────────────
# Clave secreta para firmar los JWT — generá una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-clave-aleatoria-de-32-caracteres

# Contraseña del usuario admin del panel
ADMIN_PASSWORD=cambiar-por-password-seguro

# ── CORS (en producción, poner la URL real del frontend) ─────────────────────
# Ejemplo: https://licitaciones-salta.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
